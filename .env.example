# ─── Required ────────────────────────────────────────────────────────────────
# Secret used to verify job ownership tokens (HMAC-SHA256).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this value secret. Never commit it.
DOWNLOAD_TOKEN_SECRET=paste_your_64_hex_char_key_here

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API.
# Set to your Vercel frontend URL in production if deploying frontend separately.
# Leave as * for same-origin deployment (Express serves the frontend too).
CLIENT_ORIGIN=*

# ─── Processing limits ───────────────────────────────────────────────────────
# Maximum output file size in bytes (default 500 MB)
MAX_OUTPUT_BYTES=524288000

# Maximum job processing time in seconds before the process is killed (default 5 min)
MAX_JOB_SECONDS=300

# How long completed/failed jobs and their artifacts are kept before cleanup (minutes)
JOB_EXPIRY_MINUTES=60

# ─── Storage ─────────────────────────────────────────────────────────────────
# Absolute path to the data directory. Defaults to ./data relative to server root.
# On Render: mount a Render Disk here (e.g. /mnt/data) for persistence across deploys.
# Without a disk, data is lost on every deploy/restart.
# DATA_DIR=/mnt/data

# ─── Python / yt-dlp ─────────────────────────────────────────────────────────
# Command used to invoke Python (must have yt-dlp installed as a module).
# On Linux/Docker: python3
# On Windows dev: python
PYTHON_CMD=python3

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
